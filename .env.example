# Local dev: copy to `.env` and paste values from Coolify (runtime vars).
# Coolify is not contacted automatically — same names as on razzosg-landings.
# Production containers get env from Coolify; `.env` is gitignored and not deployed.

# Build-time (Astro embeds these into HTML — Coolify: “Available at buildtime”)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_ANALYTICS_PROXY_PATH=

# Runtime (server.mjs / npm run preview — Coolify: runtime only, not buildtime)
# npm run dev proxies Umami when ANALYTICS_PROXY_PATH or PUBLIC_ANALYTICS_PROXY_PATH is set.
UMAMI_WEBSITE_ID=
ANALYTICS_PROXY_PATH=
UMAMI_UPSTREAM_URL=https://analytics.clientpodium.com
PORT=3000

# Gruppenanfrage (Resend) — runtime only
RESEND_API_KEY=
GROUPS_ENQUIRY_FROM=ciao@razzosg.ch
GROUPS_ENQUIRY_TO=markusalbert@me.com
