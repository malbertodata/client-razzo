        .nfc-lang a {
          font-size: clamp(0.820137rem, 0.2534vw + 0.76942rem, 999rem);
        }
      }
      .nfc-lang-current {
        font-weight: 700;
        text-decoration: underline;
      }
      .nfc-lang a {
        position: relative;
        font-weight: 400;
        text-decoration: none;
      }
      .nfc-lang a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0;
        height: 2px;
        background-color: currentColor;
        transition: width 0.3s ease;
      }
      .nfc-lang a:hover::after {
        width: 100%;
      }
      .nfc-site-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(0.75rem, 2.5vw, 1rem);
        width: 100%;
        max-width: min(100%, 22rem);
        padding: 1.25rem 0.75rem var(--nfc-footer-row-bottom);
        box-sizing: border-box;
        grid-row: 2;
        align-self: center;
      }
      .nfc-brand-plate .nfc-contact {
        position: absolute;
        left: 0;
        bottom: calc(
          var(--nfc-footer-row-bottom) +
            (var(--nfc-footer-link-size) * 1.35 - var(--nfc-contact-icon-size)) / 2
        );
        display: flex;
        flex-direction: column-reverse;
        flex-wrap: nowrap;
        align-items: flex-start;
        gap: 1.125rem;
        padding-left: 1rem;
        pointer-events: auto;
      }
      @media (min-width: 1024px) {
        .nfc-brand-plate .nfc-contact {
          padding-left: 2.5rem;
        }
      }
      @media (max-width: 1023px) {
        .nfc-brand-plate .nfc-contact {
          padding-left: 1rem;
        }
      }
      .nfc-contact a {
        display: flex;
        flex-shrink: 0;
        color: oklch(96.7% 0.003 264.542);
        line-height: 0;
        transition: opacity 0.15s ease;
      }
      .nfc-contact a:hover {
        opacity: 0.85;
      }
      .nfc-contact svg {
        width: var(--nfc-contact-icon-size);
        height: var(--nfc-contact-icon-size);
        stroke: currentColor;
        fill: none;
      }
      .nfc-contact-icon--instagram svg circle:last-of-type {
        fill: currentColor;
        stroke: none;
      }
      /* Short viewports: keep footer pinned; scroll when details expand. */
      @media (max-height: 900px) {
        .nfc-footer {
          box-sizing: border-box;
          max-width: 100%;
          overflow-x: auto;
          overflow-y: hidden;
          justify-content: safe center;
          -webkit-overflow-scrolling: touch;
          overscroll-behavior-x: contain;
          scrollbar-width: thin;
          padding-inline: 0.25rem;
          padding-bottom: 0.125rem;
        }
      }
      .nfc-footer {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: center;
        gap: clamp(0.625rem, 3.5vw, 1.25rem);
        width: 100%;
        max-width: 22rem;
        font-size: clamp(0.71875rem, 2.2vw + 0.625rem, 0.820137rem);
        font-weight: 400;
        line-height: 1.35;
        text-align: center;
      }
      @media (min-width: 1024px) {
        .nfc-footer {
          font-size: clamp(0.820137rem, 0.2534vw + 0.76942rem, 999rem);
          line-height: clamp(1.06618rem, calc(1.39555rem + 0.003294 * (100vw - 120rem)), 999rem);
        }
      }
      .nfc-footer a {
        position: relative;
        flex-shrink: 0;
        white-space: nowrap;
        color: oklch(96.7% 0.003 264.542);
        text-decoration: none;
        text-underline-offset: 4px;
      }
      .nfc-footer a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0;
        height: 2px;
        background-color: currentColor;
        transition: width 0.3s ease;
      }
      .nfc-footer a:hover::after {
        width: 100%;
      }
    </style>
    {
      umamiWebsiteId && scriptSrc ? (
        <script is:inline set:html={deferredAnalyticsBootScript(scriptSrc, umamiWebsiteId)} />
      ) : null
    }
  </head>
  <body data-fondue-page={pageId}>
    <main class="nfc-page">
      <header class="nfc-header-band">
        <a class="nfc-star-link" href="https://www.razzo.sg/" aria-label={config.siteName}>
          <svg
            class="nfc-star"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 34.5 32.4"
            aria-hidden="true"
          >
            <path
              fill="#fff"
              d="M28.2,17.1c-.8.8-1.8,1.6-2.5,2.5-.6.7-.4,1.4-.3,2.3.3,2.5.9,4.9,1.2,7.4,0,.8-.3,1.2-1.1.9-2.4-1.1-4.7-2.5-7-3.6-.4-.2-.8-.4-1.2-.4-.3,0-.9.2-1.2.3-2.3,1.1-4.5,2.4-6.8,3.5-.7.3-1.5.5-1.6-.5,0-.8.3-2.2.4-3.1.3-1.7.7-3.5.8-5.2.1-1.2-.4-1.6-1.1-2.4-1.6-1.6-3.4-3.2-4.9-4.9-.3-.3-.7-.8-.5-1.3.2-.5,1.2-.6,1.6-.7,2.3-.4,4.7-.6,7-1.1,1.2-.2,1.5-.7,2-1.7,1.1-2.1,2.1-4.3,3.2-6.3.3-.5.7-1.2,1.3-.8.4.3.8,1.3,1.1,1.7,1,1.9,1.9,4,3,5.9.4.8.9,1.1,1.8,1.2,2.5.5,5.1.7,7.6,1.2.5.1,1.2.3,1.1.9,0,.5-1.2,1.5-1.6,1.8-.7.7-1.5,1.5-2.2,2.2"
            ></path>
          </svg>
        </a>
        <ul class="nfc-lang" aria-label={ui.langLabel}>
          <li>
            {
              locale === 'de' ? (
                <span class="nfc-lang-current" lang="de">de</span>
              ) : (
                <a href={alternateLocaleHref} hreflang="de" lang="de" data-locale-switch="de">
                  de
                </a>
              )
            }
          </li>
          <li>
            {
              locale === 'en' ? (
                <span class="nfc-lang-current" lang="en">en</span>
              ) : (
                <a href={alternateLocaleHref} hreflang="en" lang="en" data-locale-switch="en">
                  en
                </a>
              )
            }
          </li>
        </ul>
      </header>
      <div class="nfc-brand-plate">
        <a class="nfc-brand" href="https://www.razzo.sg/" aria-label={config.siteName}>
          <div class="nfc-brand-frame">
            <div class="nfc-brand-inner">
              <img class="nfc-logo" src="/brand/logo.svg" alt="" width="57" height="540" />
            </div>
          </div>
        </a>
        <nav class="nfc-contact" aria-label={ui.contactNav}>
          <a href={contactPhoneHref} aria-label={`${ui.contactCall} ${contactPhoneLabel}`}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M5.5 4h4l1.5 4.5-2.5 1.5a12 12 0 0 0 5 5l1.5-2.5L19 14v4a1.5 1.5 0 0 1-1.5 1.5A16 16 0 0 1 3 6.5 1.5 1.5 0 0 1 4.5 5z"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href={contactEmailHref} aria-label={`${ui.contactEmail} ${groupsEmail}`}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" ry="2" stroke-width="1.5"></rect>
              <path d="M3 7l9 6 9-6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a
            class="nfc-contact-icon--instagram"
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={ui.contactInstagram}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5" stroke-width="1.5"></rect>
              <circle cx="12" cy="12" r="4" stroke-width="1.5"></circle>
              <circle cx="17.2" cy="6.8" r="1"></circle>
            </svg>
          </a>
        </nav>
      </div>
      <div class="nfc-content">
        <div class="nfc-body">
          <div class="fondue-main-stack">
            <div class="fondue-copy">
              {
                isBooking ? (
                  <h1 class="fondue-booking-headline">
                    <span
                      class="fondue-booking-headline-line fondue-booking-headline-line--spacer"
                      aria-hidden="true"></span>
                    <span class="fondue-booking-headline-line">{ui.bookingHeadlineLine1}</span>
                    {
                      ui.bookingHeadlineLine2 ? (
                        <span class="fondue-booking-headline-line">{ui.bookingHeadlineLine2}</span>
                      ) : (
                        <span
                          class="fondue-booking-headline-line fondue-booking-headline-line--spacer"
                          aria-hidden="true"></span>
                      )
                    }
                  </h1>
                ) : (
                  <h1>{page.headline}</h1>
                )
              }
              {page.intro.trim() ? <p>{page.intro}</p> : null}
            </div>
            {
              isBooking ? (
                <div class="fondue-actions">
                <nav class="nfc-links nfc-links--aligned" aria-label={ui.bookingTypeNav}>
                  <div class="fondue-booking-option">
                    <button
                      type="button"
                      class="nfc-link nfc-link--booking"
                      data-fondue-link="chalet"
                      data-fondue-show-widget
                      data-widget-src={chaletWidgetUrl}
                      data-chalet-season-first={chaletSeasonFirst}
                      data-chalet-season-last={chaletSeasonLast ?? ''}
                    >
                      <span class="nfc-link-main">
                        <span class="nfc-link-icon">
                          <FondueLinkIcon id="chalet" />
                        </span>
                        <span class="nfc-link-label">{ui.bookChalet}</span>
                      </span>
                    </button>
                    <details class="fondue-option-details">
                      <summary>
                        <span>{ui.bookingDetailsToggle}</span>
                        <svg
                          class="fondue-option-details-marker"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path d="M7.5 9.75 12 15.75 16.5 9.75Z"></path>
                        </svg>
                      </summary>
                      <div class="fondue-option-hours">
                        <span class="fondue-option-hours-season">{ui.chaletSeasonNote}</span>
                        <span>{ui.chaletHoursLine1}</span>
                        <span>{ui.chaletHoursLine2}</span>
                        <span>{ui.chaletHoursLine3}</span>
                        <span>{ui.chaletHoursLine4}</span>
                      </div>
                    </details>
                  </div>
                  <div class="fondue-booking-option">
                    <button
                      type="button"
                      class="nfc-link nfc-link--booking"
                      data-fondue-link="restaurant"
                      data-fondue-show-widget
                      data-widget-src={restaurantWidgetUrl}
                    >
                      <span class="nfc-link-main">
                        <span class="nfc-link-icon">
                          <FondueLinkIcon id="restaurant" />
                        </span>
                        <span class="nfc-link-label">{ui.bookRestaurant}</span>
                      </span>
                    </button>
                    <details class="fondue-option-details">
                      <summary>
                        <span>{ui.bookingDetailsToggle}</span>
                        <svg
                          class="fondue-option-details-marker"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path d="M7.5 9.75 12 15.75 16.5 9.75Z"></path>
                        </svg>
                      </summary>
                      <div class="fondue-option-hours">
                        <span class="fondue-option-hours-note">{ui.restaurantMenuNote}</span>
                        <span>{ui.restaurantHoursLine1}</span>
                        <span>{ui.restaurantHoursLine2}</span>
                        <span>{ui.restaurantHoursLine3}</span>
                      </div>
                    </details>
                  </div>
                </nav>
                <nav class="fondue-groups" aria-label={ui.bookingGroupsEnquiryNav}>
                  <hr class="fondue-divider" />
                  <div class="fondue-booking-option fondue-groups-enquiry">
                    <button
                      type="button"
                      class="nfc-link"
                      data-groups-sheet-open
                      aria-describedby="fondue-groups-enquiry-note"
                    >
                      <span class="nfc-link-icon">
                        <FondueLinkIcon id="groups" />
                      </span>
                      <span class="nfc-link-label">{ui.bookingGroupsEnquiryButtonLabel}</span>
                    </button>
                    <p class="fondue-groups-enquiry-note" id="fondue-groups-enquiry-note">
                      {ui.bookingGroupsEnquiryButtonHint}
                    </p>
                  </div>
                </nav>
                </div>
              ) : null
            }
          </div>
        </div>
        <div class="nfc-site-footer">
          <nav class="nfc-footer" aria-label={ui.metaNav}>
            <a href={legal.impressumUrl}>{ui.impressum}</a>
            <a href={legal.agbUrl}>{ui.agb}</a>
            <a href={legal.privacyUrl}>{ui.privacy}</a>
          </nav>
        </div>
      </div>
      {
        isBooking ? (
          <div
            class="fondue-groups-sheet"
            id="fondue-groups-sheet"
            hidden
            role="dialog"
            aria-modal="true"
            aria-labelledby="fondue-groups-sheet-title"
          >
            <button
              type="button"
              class="fondue-groups-sheet-backdrop"
              data-groups-sheet-backdrop
              tabindex="-1"
              aria-hidden="true"
            />
            <div class="fondue-groups-sheet-panel">
              <div class="fondue-groups-sheet-header">
                <h2 class="fondue-groups-sheet-title" id="fondue-groups-sheet-title">
                  {ui.bookingGroupsEnquiryModalTitle}
                </h2>
                <button
                  type="button"
                  class="fondue-groups-sheet-close"
                  data-groups-sheet-close
                  aria-label={ui.bookingGroupsModalClose}
                >
                  <span aria-hidden="true">×</span>
                </button>
              </div>
              <form
                class="fondue-groups-form"
                id="fondue-groups-form"
                data-groups-form
                data-groups-locale={locale}
                data-submit-sending={ui.bookingGroupsFormSubmitSending}
                data-submit-success={ui.bookingGroupsFormSubmitSuccess}
                data-submit-error={ui.bookingGroupsFormSubmitError}
                data-submit-invalid-email={ui.bookingGroupsFormEmailInvalid}
                data-submit-invalid-phone={ui.bookingGroupsFormPhoneInvalid}
                data-time-placeholder={ui.bookingGroupsFormTimePlaceholder}
                data-time-closed={ui.bookingGroupsFormTimeClosed}
                data-time-window-lunch={ui.bookingGroupsFormTimeWindowLunch}
                data-time-window-dinner={ui.bookingGroupsFormTimeWindowDinner}
                data-time-window-chalet-name={ui.bookingGroupsFormTimeWindowChaletName}
                data-time-window-restaurant-name={ui.bookingGroupsFormTimeWindowRestaurantName}
                data-date-closed={ui.bookingGroupsFormDateClosed}
                data-date-closed-chalet={ui.bookingGroupsFormDateChaletClosed}
                data-date-change={ui.bookingGroupsFormDateChange}
                data-time-change={ui.bookingGroupsFormTimeChange}
                data-group-size-choose={ui.bookingGroupsFormGroupSizeChoose}
                data-chalet-date-min={groupsChaletDateMin}
                data-chalet-date-max={groupsChaletDateMax}
                data-restaurant-date-min={groupsRestaurantDateMin}
                data-instagram-url={instagramUrl}
              >
                <div class="fondue-groups-form-stage">
                  <div class="fondue-groups-form-body" id="fondue-groups-form-body">
                    <p
                      class="fondue-groups-submit-status"
                      id="fondue-groups-submit-status"
                      role="status"
                      aria-live="polite"
                      hidden
                    />
                    <div class="fondue-groups-step" data-groups-step="1">
                <fieldset class="fondue-groups-fieldset">
                  <legend>{ui.bookingGroupsFormVenue}</legend>
                  <div class="fondue-groups-segment-track" role="radiogroup">
                    <span class="fondue-groups-segment-thumb" aria-hidden="true"></span>
                    <label class="fondue-groups-segment-option">
                      <input type="radio" name="venue" value="chalet" required checked />
                      <span>{ui.bookChalet}</span>
                    </label>
                    <label class="fondue-groups-segment-option">
                      <input type="radio" name="venue" value="restaurant" required />
                      <span>{ui.bookRestaurant}</span>
                    </label>
                  </div>
                </fieldset>
                <div class="fondue-groups-field fondue-groups-field--date">
                  <span class="fondue-groups-field-label" id="fondue-groups-date-label">
                    {ui.bookingGroupsFormDate}
                  </span>
                  <input type="hidden" id="fondue-groups-date" name="date" required value="" />
                  <div
                    class="fondue-groups-date-picker"
                    id="fondue-groups-date-picker"
                    role="group"
                    aria-labelledby="fondue-groups-date-label"
                  />
                </div>
                <div class="fondue-groups-field fondue-groups-field--time" id="fondue-groups-time-field" hidden>
                  <span class="fondue-groups-field-label" id="fondue-groups-time-label">
                    {ui.bookingGroupsFormTime}
                  </span>
                  <input type="hidden" id="fondue-groups-time" name="time" required value="" />
                  <div
                    class="fondue-groups-time-windows"
                    id="fondue-groups-time-windows"
                    role="group"
                    aria-labelledby="fondue-groups-time-label"
                  />
                  <p class="fondue-groups-time-empty" id="fondue-groups-time-empty" hidden></p>
                </div>
                <p
                  class="fondue-groups-field fondue-groups-field--size fondue-groups-field--size-pending"
                  id="fondue-groups-size-field"
                  hidden
                >
                  <label for="fondue-groups-size">
                    <span>{ui.bookingGroupsFormGroupSize}</span>
                    <output
                      class="fondue-groups-size-value"
                      id="fondue-groups-size-display"
                      for="fondue-groups-size">{ui.bookingGroupsFormGroupSizeChoose}</output>
                  </label>
                  <input
                    id="fondue-groups-size"
                    name="groupSize"
                    type="range"
                    required
                    min={groupsSizeMin}
                    max={groupsSizeMax}
                    step={1}
                    value={groupsSizeDefault}
                  />
                  <span class="fondue-groups-size-ticks" aria-hidden="true">
                    <span>{groupsSizeMin}</span>
                    <span class="fondue-groups-size-hint">
                      <svg viewBox="0 0 24 12" width="22" height="11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 6h20M6 2 2 6l4 4M18 2l4 4-4 4" />
                      </svg>
                    </span>
                    <span>{groupsSizeMax}</span>
                  </span>
                </p>
                <div class="fondue-groups-sheet-actions">
                  <button type="button" class="nfc-link" data-groups-step-next disabled>
                    {ui.bookingGroupsFormContinue}
                  </button>
                </div>
                </div>
                <div class="fondue-groups-step" data-groups-step="2" hidden>
                <p class="fondue-groups-field fondue-groups-field--contact-lead">
                  <label for="fondue-groups-name">{ui.bookingGroupsFormName}</label>
                  <input
                    id="fondue-groups-name"
                    name="name"
                    type="text"
                    required
                    disabled
                    autocomplete="name"
                  />
                </p>
                <p class="fondue-groups-field">
                  <label for="fondue-groups-phone">{ui.bookingGroupsFormPhone}</label>
                  <input
                    id="fondue-groups-phone"
                    name="phone"
                    type="tel"
                    required
                    disabled
                    autocomplete="tel"
                    inputmode="tel"
                  />
                </p>
                <p class="fondue-groups-field">
                  <label for="fondue-groups-email">{ui.bookingGroupsFormEmail}</label>
                  <input
                    id="fondue-groups-email"
                    name="email"
                    type="email"
                    required
                    disabled
                    autocomplete="email"
                    inputmode="email"
                  />
                </p>
                <p class="fondue-groups-field fondue-groups-field--notes">
                  <label for="fondue-groups-notes">{ui.bookingGroupsFormNotes}</label>
                  <textarea
                    id="fondue-groups-notes"
                    name="notes"
                    disabled
                    rows={3}
                  />
                </p>
                <div class="fondue-groups-sheet-actions fondue-groups-sheet-actions--split">
                  <button
                    type="button"
                    class="nfc-link nfc-link--ghost fondue-groups-sheet-back"
                    data-groups-step-back
                    aria-label={ui.bookingGroupsFormBack}
                  >
                    <span class="fondue-groups-sheet-back-icon" aria-hidden="true">‹</span>
                  </button>
                  <button
                    type="submit"
                    class="nfc-link fondue-groups-sheet-primary"
                    data-groups-submit
                  >
                    {ui.bookingGroupsFormSubmit}
                  </button>
                </div>
                </div>
                  </div>
                  <div
                    class="fondue-groups-form-success"
                    id="fondue-groups-form-success"
                    hidden
                    role="status"
                    aria-live="polite"
                  >
                    <svg
                      class="fondue-groups-form-success-check"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="10" stroke-width="1.25"></circle>
                      <path d="M7.5 12.5l3 3 6-6.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <p class="fondue-groups-form-success-message" data-groups-success-message>
                      {ui.bookingGroupsFormSubmitSuccess}
                    </p>
                    <a
                      class="nfc-link fondue-groups-form-success-instagram"
                      data-groups-success-instagram
                      href={instagramUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="nfc-link-icon">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          width="18"
                          height="18"
                          aria-hidden="true"
                        >
                          <rect x="3" y="3" width="18" height="18" rx="5" ry="5" stroke-width="1.5"></rect>
                          <circle cx="12" cy="12" r="4" stroke-width="1.5"></circle>
                          <circle cx="17.2" cy="6.8" r="1"></circle>
                        </svg>
                      </span>
                      <span class="nfc-link-label">{ui.bookingGroupsFormSubmitSuccessInstagram}</span>
                    </a>
                  </div>
                </div>
              </form>
              <div
                class="fondue-groups-cancel-confirm"
                id="fondue-groups-cancel-confirm"
                hidden
                role="alertdialog"
                aria-modal="true"
                aria-describedby="fondue-groups-cancel-confirm-text"
              >
                <p class="fondue-groups-cancel-confirm-text" id="fondue-groups-cancel-confirm-text">
                  {ui.bookingGroupsModalCancelMessage}
                </p>
                <div class="fondue-groups-cancel-confirm-actions">
                  <button type="button" class="nfc-link" data-groups-cancel-dismiss>
                    {ui.bookingGroupsModalCancelDismiss}
                  </button>
                </div>
              </div>
            </div>
          </div>
        ) : null
      }
    </main>
    {
      isBooking ? (
        <div class="fondue-widget-overlay" id="fondue-widget-overlay" hidden>
          <button type="button" class="fondue-widget-back" id="fondue-widget-close">
            {ui.back}
          </button>
          <div class="fondue-widget-frame">
            <iframe
              class="fondue-widget"
              id="fondue-aleno-widget"
              title={ui.widgetTitle}
              data-widget-src={restaurantWidgetUrl}
            />
          </div>
        </div>
      ) : null
    }
    {
      isBooking ? (
        <script>
          import '../scripts/fondue-booking-widget.ts';
          import '../scripts/fondue-groups-sheet.ts';
        </script>
      ) : null
    }
    <script is:inline>
      const safeTrack = (name, data) => {
        const track = window.umami?.track;
        if (typeof track !== 'function') return;
        try {
          track(name, data);
        } catch {
          /* optional */
        }
      };

      document.querySelectorAll('[data-fondue-link]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-fondue-link');
          if (!id) return;
          safeTrack('fondue_click', { link: id });
        });
      });

      document.querySelectorAll('[data-locale-switch]').forEach((el) => {
        el.addEventListener('click', () => {
          const to = el.getAttribute('data-locale-switch');
          if (to !== 'de' && to !== 'en') return;
          safeTrack('locale_switch', { to });
        });
      });
    </script>
  </body>
</html>
