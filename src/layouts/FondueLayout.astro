---
import type { CampaignConfig, FonduePageConfig } from '@/lib/campaign';
import {
  resolveChaletEmbeddedWidgetUrl,
  resolveRestaurantWidgetUrl,
  zurichTodayIso,
} from '@/lib/aleno';
import { analyticsScriptSrc, deferredAnalyticsBootScript } from '@/lib/analytics';
import {
  htmlLang,
  legalUrls,
  switchLocalePath,
  uiCopy,
  type Locale,
} from '@/lib/i18n';
import FondueLinkIcon from '@/components/FondueLinkIcon.astro';

interface Props {
  config: CampaignConfig;
  locale: Locale;
  pageId: string;
  page: FonduePageConfig;
}

const { config, locale, pageId, page } = Astro.props;

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim() || null;
const analyticsProxyPath = import.meta.env.PUBLIC_ANALYTICS_PROXY_PATH?.trim() || null;
const scriptSrc = analyticsScriptSrc(analyticsProxyPath);
const ui = uiCopy(locale);
const legal = legalUrls(locale);
const instagramUrl = 'https://www.instagram.com/restaurant.razzo/';
const contactPhoneLabel = '+41 71 220 90 00';
const contactPhoneHref = 'tel:41712209000';
const alternateLocaleHref = switchLocalePath({
  locale,
  pageId,
  search: Astro.url.searchParams,
});

const isBooking = page.kind === 'booking';
const incomingSearch = Astro.url.searchParams;
const reservationCtx = { incoming: incomingSearch, locale };
const chaletSeasonFirst = config.chaletFirstAvailableDate?.trim() || '2026-11-03';
const chaletSeasonLast = config.chaletLastAvailableDate?.trim();
const chaletWidgetUrl = resolveChaletEmbeddedWidgetUrl(
  config.chaletBookingUrl,
  reservationCtx,
  chaletSeasonFirst,
  chaletSeasonLast,
);
const restaurantWidgetUrl = resolveRestaurantWidgetUrl(config.restaurantWidgetUrl, reservationCtx);
const groupsEmail = config.groupsEnquiryEmail?.trim() || 'ciao@razzosg.ch';
const contactEmailHref = `mailto:${groupsEmail}`;
const groupsChaletDateMin = chaletSeasonFirst;
const groupsChaletDateMax = '2027-01-30';
const groupsRestaurantDateMin = zurichTodayIso(new Date());
const groupsSizeMin = 9;
const groupsSizeMax = 80;
const groupsSizeDefault = Math.round((groupsSizeMin + groupsSizeMax) / 2);
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{config.siteName} — {page.title}</title>
    {
      isBooking ? (
        <>
          <link rel="dns-prefetch" href="//mytools.aleno.me" />
          <link rel="preconnect" href="https://mytools.aleno.me" crossorigin />
          <script src={config.alenoAssets.scriptSrc} is:inline />
          <link href={config.alenoAssets.styleHref} rel="stylesheet" />
        </>
      ) : null
    }
    <style is:global>
      @font-face {
        font-family: 'Aether A Mono';
        src: url('/brand/Aether-AMono.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        overflow-x: hidden;
        scrollbar-gutter: stable;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        overflow-x: hidden;
        background: #000;
        color: #fff;
        font-family: 'Aether A Mono', ui-monospace, monospace;
        -webkit-font-smoothing: antialiased;
      }
      .nfc-page {
        --nfc-logo-gutter: calc(1.25rem + 0.875rem + 20px + 0.75rem);
        --nfc-lang-gutter: 3.25rem;
        --nfc-footer-row-bottom: max(1.75rem, env(safe-area-inset-bottom));
        --nfc-footer-link-size: clamp(0.71875rem, 2.2vw + 0.625rem, 0.820137rem);
        --nfc-contact-icon-size: 1.25rem;
        position: relative;
        height: 100dvh;
        max-height: 100dvh;
        overflow: hidden;
      }
      @media (min-width: 1024px) {
        .nfc-page {
          --nfc-logo-gutter: calc(2.5rem + 2.5rem + 57px + 1rem);
          --nfc-lang-gutter: 5rem;
          --nfc-contact-icon-size: 1.5rem;
        }
      }
      @media (max-width: 1023px) {
        .nfc-page {
          --nfc-logo-gutter: calc(1rem + 0.5rem + 20px + 0.375rem);
          --nfc-lang-gutter: 2.75rem;
        }
        .nfc-body {
          --fondue-stack-gap: 1.125rem;
        }
        .nfc-header-band {
          padding: 0.75rem 1rem 0 0;
        }
        .nfc-logo {
          top: calc(0.75rem + 1.75rem + 0.625rem);
        }
        .nfc-content {
          padding-top: 1.5rem;
          transform: translateX(calc((var(--nfc-lang-gutter) - var(--nfc-logo-gutter)) / 2));
        }
      }
      .nfc-brand-plate {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 10;
        box-sizing: border-box;
        width: var(--nfc-logo-gutter);
        height: 100%;
        max-height: 100dvh;
        pointer-events: none;
      }
      .nfc-header-band {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 30;
        display: grid;
        grid-template-columns: var(--nfc-logo-gutter) 1fr auto;
        align-items: center;
        box-sizing: border-box;
        padding: 1rem 1.25rem 0 0;
        pointer-events: none;
      }
      @media (min-width: 1024px) {
        .nfc-header-band {
          padding: 2.25rem 2.5rem 0 0;
        }
      }
      .nfc-star-link {
        grid-column: 1;
        justify-self: center;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.25rem;
        color: inherit;
        text-decoration: none;
        pointer-events: auto;
      }
      .nfc-header-band .nfc-lang {
        grid-column: 3;
        justify-self: end;
        pointer-events: auto;
      }
      .nfc-brand {
        z-index: 10;
        flex-shrink: 0;
        width: 100%;
        color: inherit;
        text-decoration: none;
        pointer-events: auto;
      }
      @media (min-width: 1024px) {
        .nfc-brand {
          z-index: 30;
        }
      }
      .nfc-brand-frame {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 0 0.5rem 0 0.375rem;
      }
      @media (min-width: 1024px) {
        .nfc-brand-frame {
          padding: 0 1.25rem;
        }
      }
      .nfc-brand-inner {
        position: relative;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        min-height: calc(2.75rem + (540 / 57) * 20px);
      }
      @media (min-width: 1024px) {
        .nfc-brand-inner {
          width: 57px;
          min-height: calc(5.5rem + 540px);
        }
      }
      .nfc-star {
        display: block;
        width: 0.75rem;
        height: 0.75rem;
      }
      @media (min-width: 1024px) {
        .nfc-star {
          width: 1.25rem;
          height: 1.25rem;
        }
      }
      .nfc-logo {
        position: absolute;
        top: calc(1rem + 1.75rem + 0.75rem);
        left: 50%;
        display: block;
        height: auto;
        width: 20px;
        max-width: 20px;
        object-fit: contain;
        visibility: hidden;
        opacity: 0;
        transform: translateX(-50%) translateY(90%);
        animation: nfc-logo-enter 1000ms cubic-bezier(0, 0, 0.2, 1) 700ms forwards;
      }
      @media (min-width: 1024px) {
        .nfc-logo {
          top: calc(2.25rem + 1.75rem + 1.25rem);
          width: 57px;
          max-width: none;
        }
      }
      @keyframes nfc-logo-enter {
        from {
          visibility: visible;
          opacity: 0.1;
          transform: translateX(-50%) translateY(90%);
        }
        to {
          visibility: visible;
          opacity: 1;
          transform: translateX(-50%) translateY(0);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .nfc-logo {
          animation: none;
          visibility: visible;
          opacity: 1;
          transform: translateX(-50%) translateY(0);
        }
      }
      .nfc-content {
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        align-items: stretch;
        justify-items: center;
        width: 100%;
        height: 100%;
        min-height: 100dvh;
        max-height: 100dvh;
        box-sizing: border-box;
        padding: 2rem var(--nfc-lang-gutter) 0 var(--nfc-logo-gutter);
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
      }
      .nfc-body {
        --fondue-stack-gap: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        height: 100%;
        min-height: 0;
        align-self: stretch;
        grid-row: 1;
      }
      .nfc-body:has(.fondue-main-stack) {
        justify-content: center;
        padding-bottom: clamp(2.5rem, 8vh, 4.5rem);
        box-sizing: border-box;
      }
      .fondue-main-stack {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(var(--fondue-stack-gap) + 0.875rem);
        width: 100%;
        flex-shrink: 0;
      }
      .fondue-copy {
        flex-shrink: 0;
        width: min(100%, 22rem);
        max-width: 100%;
        padding-top: 0;
      }
      .fondue-actions {
        display: flex;
        flex: none;
        flex-direction: column;
        align-items: center;
        gap: var(--fondue-stack-gap);
        width: 100%;
      }
      .fondue-copy {
        text-align: center;
        line-height: 1.45;
        letter-spacing: 0.02em;
      }
      .fondue-copy h1,
      .fondue-booking-headline {
        margin: 0;
        font-size: clamp(1.375rem, 4.5vw + 0.875rem, 1.75rem);
        font-weight: 400;
        line-height: 1.3;
        letter-spacing: 0.03em;
      }
      .fondue-booking-headline {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: calc(3 * 1.3em);
      }
      .fondue-booking-headline-line {
        display: block;
      }
      .fondue-booking-headline-line--spacer {
        visibility: hidden;
        user-select: none;
      }
      .fondue-booking-headline-line--spacer::before {
        content: '\00a0';
      }
      .fondue-copy p {
        margin: 0;
        opacity: 0.85;
        font-size: 0.875rem;
      }
      .fondue-copy p + p {
        margin-top: 0.625rem;
      }
      .fondue-copy a {
        color: inherit;
      }
      .nfc-links {
        display: flex;
        flex-direction: column;
        gap: var(--fondue-stack-gap);
        width: min(100%, 22rem);
        max-width: 100%;
      }
      .fondue-booking-option {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        width: 100%;
      }
      .fondue-option-details {
        width: 100%;
      }
      .fondue-option-details summary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        list-style: none;
        cursor: pointer;
        padding: 0.125rem 0.25rem;
        text-align: center;
        font-size: 0.8125rem;
        line-height: 1.35;
        letter-spacing: 0.02em;
        color: oklch(72% 0.006 264.542);
        transition: color 0.15s ease;
      }
      .fondue-option-details-marker {
        flex-shrink: 0;
        align-self: center;
        display: block;
        width: 1.35em;
        height: 1.35em;
        fill: currentColor;
        transition: transform 0.2s ease;
      }
      .fondue-option-details[open] .fondue-option-details-marker {
        transform: rotate(180deg);
      }
      .fondue-option-details summary::-webkit-details-marker {
        display: none;
      }
      .fondue-option-details summary::marker {
        content: '';
      }
      .fondue-option-details summary:hover,
      .fondue-option-details summary:focus-visible {
        color: #fff;
        outline: none;
      }
      .fondue-option-details[open] summary {
        color: oklch(88% 0.006 264.542);
        margin-bottom: 0.25rem;
      }
      @media (min-width: 1024px) {
        .fondue-option-details summary {
          font-size: 0.875rem;
        }
      }
      .nfc-link-main {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        box-sizing: border-box;
        width: 100%;
        min-height: 3.25rem;
        padding: 1rem 1.25rem;
        border: 1.5px solid rgba(255, 255, 255, 0.5);
        transition: background 0.15s ease, border-color 0.15s ease;
      }
      .fondue-option-hours {
        margin: 0;
        padding: 0 0.25rem;
        text-align: center;
        font-size: 0.8125rem;
        line-height: 1.45;
        letter-spacing: 0.02em;
        color: oklch(72% 0.006 264.542);
        transition: color 0.15s ease;
        pointer-events: none;
      }
      @media (min-width: 1024px) {
        .fondue-option-hours {
          font-size: 0.875rem;
          line-height: 1.5;
        }
      }
      .fondue-option-hours > span {
        display: block;
      }
      .fondue-option-hours > span + span {
        margin-top: 0.25rem;
      }
      .fondue-option-hours-season {
        margin-bottom: 0.35rem;
      }
      .fondue-option-hours-note {
        margin-bottom: 0.5rem;
        white-space: nowrap;
        font-size: clamp(0.6875rem, 2.8vw, 0.875rem);
      }
      .nfc-links--aligned .nfc-link-label {
        text-align: center;
      }
      .fondue-groups {
        display: flex;
        flex-direction: column;
        gap: var(--fondue-stack-gap);
        width: min(100%, 22rem);
        max-width: 100%;
      }
      .fondue-divider {
        margin: 0;
        border: none;
        border-top: 1.5px solid rgba(255, 255, 255, 0.5);
        width: 100%;
        flex-shrink: 0;
      }
      .fondue-groups .nfc-link {
        justify-content: center;
        min-height: 3.25rem;
        color: oklch(72% 0.006 264.542);
        border-color: rgba(255, 255, 255, 0.38);
      }
      .fondue-groups .nfc-link:hover,
      .fondue-groups .nfc-link:focus-visible {
        color: oklch(82% 0.006 264.542);
        border-color: rgba(255, 255, 255, 0.55);
        background: rgba(255, 255, 255, 0.05);
      }
      .fondue-groups-enquiry .nfc-link {
        padding-inline: 0.625rem;
      }
      .fondue-groups-enquiry .nfc-link-label {
        white-space: nowrap;
      }
      .fondue-groups-enquiry-note {
        margin: 0;
        padding: 0.125rem 0.25rem;
        text-align: center;
        font-size: 0.8125rem;
        line-height: 1.35;
        letter-spacing: 0.02em;
        color: oklch(72% 0.006 264.542);
      }
      @media (min-width: 1024px) {
        .fondue-groups-enquiry-note {
          font-size: 0.875rem;
        }
      }
      body.fondue-groups-open {
        overflow: hidden;
      }
      .fondue-groups-sheet {
        position: fixed;
        inset: 0;
        z-index: 210;
        display: grid;
        grid-template-columns: var(--nfc-logo-gutter) minmax(0, 1fr) var(--nfc-lang-gutter);
        grid-template-rows: minmax(0, 1fr);
        box-sizing: border-box;
        padding-top: max(0.625rem, env(safe-area-inset-top));
        padding-bottom: max(0.625rem, env(safe-area-inset-bottom));
        pointer-events: none;
      }
      .fondue-groups-sheet[hidden] {
        display: none;
      }
      .fondue-groups-sheet-backdrop {
        position: fixed;
        inset: 0;
        z-index: 0;
        border: none;
        padding: 0;
        background: rgba(0, 0, 0, 0.72);
        cursor: default;
        pointer-events: auto;
      }
      .fondue-groups-sheet-panel {
        position: relative;
        z-index: 1;
        grid-column: 2;
        grid-row: 1;
        place-self: center center;
        box-sizing: border-box;
        width: min(100%, 22rem);
        max-width: 22rem;
        pointer-events: auto;
        max-height: calc(
          100dvh - 1.25rem - env(safe-area-inset-top) - env(safe-area-inset-bottom)
        );
        overflow-x: hidden;
        overflow-y: auto;
        padding: 0.875rem 1rem 0.75rem;
        border: 1.5px solid rgba(255, 255, 255, 0.5);
        background: #000;
        color: inherit;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
          'Courier New', monospace;
        font-size: 0.875rem;
        line-height: 1.35;
        letter-spacing: 0.02em;
      }
      .fondue-groups-sheet-header {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        min-height: 2.75rem;
        margin-bottom: 0.625rem;
      }
      .fondue-groups-sheet-title {
        margin: 0;
        flex: 1;
        min-width: 0;
        font: inherit;
        font-size: 1rem;
        line-height: 1.25;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #fff;
      }
      .fondue-groups-sheet-close {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: center;
        width: 2.75rem;
        height: 2.75rem;
        margin: 0 -0.5rem 0 0;
        padding: 0;
        border: none;
        background: transparent;
        color: oklch(88% 0.006 264.542);
        font-family: inherit;
        font-size: 2rem;
        font-weight: 300;
        line-height: 1;
        cursor: pointer;
        transition: color 0.15s ease, opacity 0.15s ease;
      }
      .fondue-groups-sheet-close:hover {
        color: #fff;
      }
      .fondue-groups-sheet-close:focus-visible {
        color: #fff;
        outline: 1px solid rgba(255, 255, 255, 0.45);
        outline-offset: 2px;
      }
      .fondue-groups-form {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        margin: 0;
        min-width: 0;
        max-width: 100%;
      }
      .fondue-groups-step {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-width: 0;
        max-width: 100%;
      }
      .fondue-groups-field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin: 0;
      }
      .fondue-groups-field--date,
      .fondue-groups-field--size,
      .fondue-groups-field--contact-lead,
      .fondue-groups-field--notes {
        margin-top: 0;
      }
      .fondue-groups-step[data-groups-step='2'] {
        padding-top: 0.75rem;
      }
      .fondue-groups-field label,
      .fondue-groups-field-label,
      .fondue-groups-fieldset legend {
        margin: 0;
        color: oklch(58% 0.006 264.542);
      }
      .fondue-groups-date-picker {
        margin-top: 0.25rem;
        padding: 0.5rem;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: rgba(255, 255, 255, 0.04);
      }
      .fondue-groups-date-picker--picked {
        padding: 0.35rem 0.5rem;
      }
      .fondue-groups-cal-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }
      .fondue-groups-cal-summary[hidden],
      .fondue-groups-cal-panel[hidden],
      .fondue-groups-time-picker[hidden] {
        display: none;
      }
      .fondue-groups-cal-summary-value {
        display: flex;
        flex-direction: column;
        gap: 0.05rem;
        margin: 0;
        color: #fff;
        font-size: 0.875rem;
        line-height: 1.35;
      }
      .fondue-groups-cal-summary-value-line {
        display: block;
        text-transform: capitalize;
      }
      .fondue-groups-cal-summary-change {
        flex-shrink: 0;
        padding: 0.25rem 0.5rem;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: transparent;
        color: oklch(88% 0.006 264.542);
        font: inherit;
        font-size: 0.75rem;
        line-height: 1.2;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 0.15em;
      }
      .fondue-groups-cal-summary-change:hover,
      .fondue-groups-cal-summary-change:focus-visible {
        border-color: rgba(255, 255, 255, 0.55);
        color: #fff;
        outline: none;
      }
      .fondue-groups-cal-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
      }
      .fondue-groups-cal-title {
        flex: 1;
        text-align: center;
        color: #fff;
        font-size: 0.8125rem;
        letter-spacing: 0.03em;
        text-transform: capitalize;
      }
      .fondue-groups-cal-nav-btn {
        flex-shrink: 0;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: 1.125rem;
        line-height: 1;
        cursor: pointer;
      }
      .fondue-groups-cal-nav-btn:hover:not(:disabled),
      .fondue-groups-cal-nav-btn:focus-visible:not(:disabled) {
        border-color: rgba(255, 255, 255, 0.55);
        background: rgba(255, 255, 255, 0.06);
        outline: none;
      }
      .fondue-groups-cal-nav-btn:disabled {
        opacity: 0.25;
        cursor: not-allowed;
      }
      .fondue-groups-cal-weekdays,
      .fondue-groups-cal-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 0.2rem;
      }
      .fondue-groups-cal-weekdays {
        margin-bottom: 0.35rem;
        color: oklch(58% 0.006 264.542);
        font-size: 0.6875rem;
        text-align: center;
      }
      .fondue-groups-cal-pad {
        display: block;
        min-height: 2rem;
      }
      .fondue-groups-cal-day {
